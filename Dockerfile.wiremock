# Dockerfile for WireMock Server
FROM eclipse-temurin:21-jdk as builder

WORKDIR /app

# Copy Maven files
COPY pom.xml .
COPY src ./src

# Build the project
RUN apt-get update && apt-get install -y maven && \
    mvn clean package -DskipTests && \
    maven --version

# Runtime stage
FROM eclipse-temurin:21-jdk

WORKDIR /app

# Copy the built JAR from builder
COPY --from=builder /app/target/wiremock-server.jar .

# Expose the port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD curl -f http://localhost:8080/__admin/mappings || exit 1

# Run the application
CMD ["java", "-jar", "wiremock-server.jar"]

